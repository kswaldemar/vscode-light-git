{
  "name": "vscode-light-git",
  "displayName": "Light Git",
  "description": "Lightweight git tools for file comparison and remote links",
  "version": "1.7.1",
  "publisher": "kswaldemar",
  "engines": {
    "vscode": "^1.74.0"
  },
  "categories": ["Other"],
  "icon": "icons/icon.png",
  "repository": {
    "type": "git",
    "url": "https://github.com/kswaldemar/vscode-light-git"
  },
  "license": "MIT",
  "activationEvents": [],
  "main": "./out/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "lightGit.compareWithRevision",
        "title": "Compare with Revision",
        "category": "Light Git"
      },
      {
        "command": "lightGit.openRemote",
        "title": "Open in Remote",
        "category": "Light Git"
      },
      {
        "command": "lightGit.openRemoteMain",
        "title": "Open in Remote (main)",
        "category": "Light Git"
      },
      {
        "command": "lightGit.copyLineRangePath",
        "title": "Copy Line Range + Path",
        "category": "Light Git"
      },
      {
        "command": "lightGit.openMergeBaseDiff",
        "title": "Open Merge-base Diff",
        "category": "Light Git"
      },
      {
        "command": "lightGit.refreshMergeBaseChanges",
        "title": "Refresh",
        "category": "Light Git",
        "icon": "$(refresh)"
      },
      {
        "command": "lightGit.openChangedFile",
        "title": "Open File",
        "category": "Light Git",
        "icon": "$(go-to-file)"
      },
      {
        "command": "lightGit.showSelectionHistory",
        "title": "Show Selection History",
        "category": "Light Git"
      },
      {
        "command": "lightGit.refreshSelectionHistory",
        "title": "Refresh",
        "category": "Light Git",
        "icon": "$(refresh)"
      },
      {
        "command": "lightGit.openSelectionCommitDiff",
        "title": "Open Selection Diff",
        "category": "Light Git"
      },
      {
        "command": "lightGit.openSelectionCommitFullDiff",
        "title": "Open Full File Diff",
        "category": "Light Git",
        "icon": "$(file)"
      },
      {
        "command": "lightGit.openCommitInRemote",
        "title": "Open Commit/PR in Browser",
        "category": "Light Git",
        "icon": "$(link-external)"
      },
      {
        "command": "lightGit.showFullFileDiff",
        "title": "Show Full File",
        "category": "Light Git",
        "icon": "$(file)"
      },
      {
        "command": "lightGit.showSelectionDiffOnly",
        "title": "Show Selection Only",
        "category": "Light Git",
        "icon": "$(list-selection)"
      },
      {
        "command": "lightGit.selectionDiffPrevCommit",
        "title": "Previous Commit",
        "category": "Light Git",
        "icon": "$(triangle-up)"
      },
      {
        "command": "lightGit.selectionDiffNextCommit",
        "title": "Next Commit",
        "category": "Light Git",
        "icon": "$(triangle-down)"
      }
    ],
    "views": {
      "scm": [
        {
          "id": "lightGit.mergeBaseChanges",
          "name": "Branch Changes (vs main)",
          "icon": "$(git-pull-request)",
          "contextualTitle": "Light Git"
        },
        {
          "id": "lightGit.selectionHistory",
          "name": "Selection History",
          "icon": "$(history)",
          "contextualTitle": "Light Git"
        }
      ]
    },
    "menus": {
      "view/title": [
        {
          "command": "lightGit.refreshMergeBaseChanges",
          "when": "view == lightGit.mergeBaseChanges",
          "group": "navigation"
        },
        {
          "command": "lightGit.refreshSelectionHistory",
          "when": "view == lightGit.selectionHistory",
          "group": "navigation"
        }
      ],
      "view/item/context": [
        {
          "command": "lightGit.openChangedFile",
          "when": "view == lightGit.mergeBaseChanges && viewItem == lightGitFile",
          "group": "inline"
        },
        {
          "command": "lightGit.openCommitInRemote",
          "when": "view == lightGit.selectionHistory && viewItem == lightGitSelectionCommit",
          "group": "inline"
        }
      ],
      "commandPalette": [
        {
          "command": "lightGit.openMergeBaseDiff",
          "when": "false"
        },
        {
          "command": "lightGit.refreshMergeBaseChanges",
          "when": "false"
        },
        {
          "command": "lightGit.openChangedFile",
          "when": "false"
        },
        {
          "command": "lightGit.refreshSelectionHistory",
          "when": "false"
        },
        {
          "command": "lightGit.openSelectionCommitDiff",
          "when": "false"
        },
        {
          "command": "lightGit.openSelectionCommitFullDiff",
          "when": "false"
        },
        {
          "command": "lightGit.openCommitInRemote",
          "when": "false"
        }
      ],
      "editor/title": [
        {
          "command": "lightGit.selectionDiffPrevCommit",
          "when": "resourceScheme == 'light-git-selection'",
          "group": "navigation@1"
        },
        {
          "command": "lightGit.selectionDiffNextCommit",
          "when": "resourceScheme == 'light-git-selection'",
          "group": "navigation@2"
        },
        {
          "command": "lightGit.showFullFileDiff",
          "when": "resourceScheme == 'light-git-selection' && lightGit.selectionDiffMode == 'hunk'",
          "group": "navigation@3"
        },
        {
          "command": "lightGit.showSelectionDiffOnly",
          "when": "resourceScheme == 'light-git-selection' && lightGit.selectionDiffMode == 'full'",
          "group": "navigation@3"
        }
      ],
      "explorer/context": [
        {
          "command": "lightGit.compareWithRevision",
          "when": "!explorerResourceIsFolder",
          "group": "7_modification"
        },
        {
          "command": "lightGit.openRemote",
          "when": "!explorerResourceIsFolder",
          "group": "7_modification"
        },
        {
          "command": "lightGit.openRemoteMain",
          "when": "!explorerResourceIsFolder",
          "group": "7_modification"
        }
      ],
      "editor/context": [
        {
          "command": "lightGit.compareWithRevision",
          "group": "7_modification"
        },
        {
          "command": "lightGit.openRemoteMain",
          "group": "7_modification"
        },
        {
          "command": "lightGit.openRemote",
          "group": "7_modification"
        },
        {
          "command": "lightGit.showSelectionHistory",
          "group": "7_modification"
        }
      ]
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./"
  },
  "devDependencies": {
    "@types/vscode": "^1.74.0",
    "@types/node": "16.x",
    "typescript": "^4.9.4"
  }
}